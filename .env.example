# CardMovex — Variables de Entorno
# Copia este archivo como `.env` y rellena los valores reales.
# NUNCA subas tu archivo `.env` real a Git.

# --- OpenAI ---
OPENAI_API_KEY=sk-...tu-api-key-aqui...

# --- Motor LLM ---
DEFAULT_LLM_MODEL=gpt-4o-mini

# --- Sistema de Autonomía ---
# Threshold de confianza (0.0 - 1.0). Debajo de este valor → needs_review = True
CONFIDENCE_THRESHOLD=0.85

# --- Belvo API ---
BELVO_SECRET_ID=tu-secret-id-de-belvo
BELVO_SECRET_PASSWORD=tu-secret-password-de-belvo
BELVO_ENVIRONMENT=sandbox  # o "production" cuando tengas acceso real
